{
  "name": "anita-clothing-shop",
  "private": true,
  "version": "1.0.0",
  "engines": {
    "node": "22.x"
  },
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently \"npm:dev --workspace=server\" \"npm:dev --workspace=client\"",
    "build": "npm run build --workspace=client",
    "start": "npm run start --workspace=server",
    "test": "npm test --workspace=server"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "allowScripts": {},
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  },
  "optionalDependencies": {
    "@esbuild/linux-x64": "0.25.12",
    "@rollup/rollup-linux-x64-gnu": "4.65.1"
  }
}
